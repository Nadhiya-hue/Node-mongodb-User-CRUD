<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheets" href="/stylesheets/style.css">
    <title>Read Page</title>
</head>
<body>
    <div class="main min-h-screen p-10 text-white bg-blue-400">
        <a class="text-white-500" href="/">Back To Home</a>
        <h5 class="text-2xl tracking-tighter mb-3">All Users</h5>
        <!--Users List GUI Code-->
        <div class="users flex gap-3 flex-wrap">
            <% if(users.length>0){ %>
                <% users.forEach(function(user){ %>
                <!--Individual users-->
                <div class="user p-4 w-72 border-2 rounded-lg bg-blue-350">
                    <div class="w-full h-72 bg-blue-300 overflow-hidden">
                        <img class="w-full h-full object cover" src="<%= user.imageurl%>" alt="">
                    </div>
                    <h5 class="text tracking-tighter mt-2"><%=user.name%></h5>
                    <h5 class="text tracking-tighter"><%=user.email%></h5>
                    <div class="flex gap-3 mt-3">
                        <a class="text-white-800 tracking-tighter" href="/edit/<%= user._id%>">Edit User</a>
                        <a class="text-red-600 tracking-tighter" href="/delete/<%=user._id%>">Delete User</a>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-white-600">No Users Yet.</h3>
            <% } %>

        </div>
    </div>
</body>
</html>