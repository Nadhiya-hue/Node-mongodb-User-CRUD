<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheets" href="/stylesheets/style.css">
    <title>Edit Page</title>
</head>
<body>
    <div class="main w-full min-h-screen bg-blue-300 p-5 text-white">
        <div class="text-xl tracking-tighter md-2">
            <a href="/read">Read Users</a>
        </div>
        <h5 class="text-2xl tracking-tighter mb-2 md-2">Update User</h5>
        <form action="/update/<%= user._id %>" method="post" class="flex gap-3 flex-wrap py-2">
            <input class="block px-3 py-2 border-2 border-blue-100 rounded-lg text-black" name="name" type="text" value="<%= user.name %>" ></input>
            <input class="block px-3 py-2 border-2 border-blue-100 rounded-lg text-black" name="imageurl" type="text" value="<%= user.imageurl %>"></input>
            <input class="block px-3 py-2 border-2 border-blue-100 rounded-lg text-black" name="email" type="text" value="<%= user.email%>" ></input>
            <input class="block px-3 py-2 border-2 rounded-lg bg-yellow-400 ml-2" type="submit" value="Update User">
        </form>
    </div>
</body>
</html>